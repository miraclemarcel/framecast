{
  "name": "framecast",
  "productName": "FrameCast",
  "version": "1.0.1",
  "description": "Mirror and control a real Android phone inside a realistic device frame.",
  "author": "miraclemarcel",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "fetch-deps": "node scripts/fetch-deps.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run fetch-deps && npm run typecheck && npm test && npm run build && electron-builder --win --x64",
    "make-icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.framecast.app",
    "productName": "FrameCast",
    "copyright": "Copyright © 2026 miraclemarcel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FrameCast",
      "artifactName": "FrameCast-Setup-x64.${ext}",
      "uninstallDisplayName": "FrameCast",
      "license": "LICENSE"
    },
    "publish": null
  },
  "homepage": "https://github.com/miraclemarcel/framecast",
  "repository": {
    "type": "git",
    "url": "https://github.com/miraclemarcel/framecast.git"
  },
  "bugs": {
    "url": "https://github.com/miraclemarcel/framecast/issues"
  }
}
